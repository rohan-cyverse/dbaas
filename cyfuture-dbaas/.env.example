# Required on the VM, Laptop A, and Laptop B. All three values must address
# the same central MySQL schema hosted on the VM; do not create per-laptop DBs.
METADATA_DB_URL=jdbc:mysql://metadata-vm.example.internal:3306/dbaas_metadata_current_0972?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
METADATA_DB_USERNAME=dbaas
METADATA_DB_PASSWORD=replace-with-central-metadata-password

# Laptops are read-only for shared HAProxy infrastructure. The designated VM
# production service must set this to true in its systemd environment file.
DBAAS_GATEWAY_RECONCILE_ENABLED=false

# Optional SSH-tunnel settings for a laptop when direct MySQL access to the VM
# is unavailable. In that case point METADATA_DB_URL at the selected local bind
# host and port, then set METADATA_DB_TUNNEL_PORT to that same local port.
# METADATA_DB_TUNNEL_PORT=3307
# METADATA_TUNNEL_VM_HOST=vm.example.internal
# METADATA_TUNNEL_SSH_PORT=22
# METADATA_TUNNEL_BIND_HOST=localhost
# METADATA_DB_HOST=metadata-vm.example.internal
# METADATA_DB_PORT=3306
DBAAS_KUBECONFIG=C:/Users/rohan.vishwakarma/Desktop/yaml/dbaas.kubeconfig
# Leave at 6 for an existing current installation. Set to 2 only for a
# one-time upgrade of an older pre-lifecycle metadata schema.
FLYWAY_BASELINE_VERSION=6
# Local HTTP port. Change this to 8081 when 8080 is already occupied.
SERVER_PORT=8080
