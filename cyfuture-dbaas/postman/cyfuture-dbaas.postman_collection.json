{
  "info": {
    "_postman_id": "2b9fb3b4-4dd5-4b58-8df7-f8793713c0b2",
    "name": "Cyfuture DBaaS - Organizations, Projects and Databases",
    "description": "DBaaS creates and manages the default organization in the backend. Project responses expose organizationId, and every project is server-bound to that organization. Immutable IDs (org-xxxx, prj-xxxx, db-xxxx) identify resources; database names are human-facing handles. Omit a database name to receive a unique engine-prefixed handle. Keep an Idempotency-Key unchanged only when retrying the exact same infrastructure request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "databaseId",
      "value": ""
    },
    {
      "key": "operationId",
      "value": ""
    },
    {
      "key": "componentName",
      "value": "postgresql"
    },
    {
      "key": "volumeName",
      "value": "data"
    },
    {
      "key": "newStorageSize",
      "value": "30Gi"
    }
  ],
  "item": [
    {
      "name": "1. Organization Settings and Project Creation",
      "description": "The organization is created and selected by the backend. There is no user-facing create, list, or organization-selection request. Users may only update its display name and description; projects are always bound to its immutable organizationId.",
      "item": [
        {
          "name": "Get Backend-Managed Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization is available', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.organizationId).to.match(/^org-/);",
                  "  pm.expect(body.displayName).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('organizationId', body.organizationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organization"
              ]
            },
            "description": "Returns the backend-managed default organization. If the seed has not yet run, the backend creates it with an immutable ID and a friendly display name."
          }
        },
        {
          "name": "Update Organization Name and Description",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Customer Platform\",\n  \"description\": \"Updated tenant details\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organization"
              ]
            },
            "description": "Only displayName and description are accepted. The backend-managed organization ID, status, and project ownership cannot be changed by this API."
          }
        },
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.projectId).to.match(/^prj-/);",
                  "  pm.expect(body.organizationId).to.equal(pm.collectionVariables.get('organizationId'));",
                  "  pm.collectionVariables.set('projectId', body.projectId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Test Project\",\n  \"description\": \"Database provisioning tests\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ]
            },
            "description": "Only displayName and description are accepted. The backend assigns the default organization, projectId, and namespace internally. Omit displayName if you want a generated friendly name."
          }
        }
      ]
    },
