    {
      "name": "Database Provisioning - All Engines and Modes",
      "description": "Create examples for all engine/mode combinations supported by the backend. Each successful request stores databaseId and operationId for the lifecycle requests below.",
      "item": [
        {
          "name": "Create PostgreSQL - Standalone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Provisioning accepted', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.test('Smooth-flow links returned', function () {",
                  "  pm.expect(body.databaseId).to.be.a('string');",
                  "  pm.expect(body.operationId).to.be.a('string');",
                  "  pm.expect(body.statusUrl).to.be.a('string');",
                  "  pm.expect(body.operationUrl).to.be.a('string');",
                  "  pm.expect(body.progress).to.be.within(0, 100);",
                  "});",
                  "if (pm.response.code === 202) {",
                  "  pm.collectionVariables.set('databaseId', body.databaseId);",
                  "  pm.collectionVariables.set('operationId', body.operationId);",
                  "  pm.collectionVariables.set('statusUrl', body.statusUrl);",
                  "  pm.collectionVariables.set('operationUrl', body.operationUrl);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "create-pg-standalone-{{$timestamp}}-{{$randomInt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"pg-standalone-{{$randomInt}}\",\"remark\":\"Create PostgreSQL - Standalone created from Postman\",\"engine\":\"POSTGRESQL\",\"mode\":\"STANDALONE\",\"version\":\"17.5.0\",\"size\":\"C1G2\",\"storageGi\":20,\"replicas\":1,\"shards\":0,\"timezone\":\"Asia/Kolkata\",\"deletionProtection\":true,\"tags\":{\"environment\":\"test\",\"createdBy\":\"postman\"}}"
